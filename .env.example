# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Channel name where the bot will listen (default is "languages")
ALLOWED_CHANNEL_NAME=languages

# Optional: Specific Channel ID to strictly lock to (leave empty to match channel name instead)
ALLOWED_CHANNEL_ID=

# Optional: Discord Guild / Server ID for instant slash command registration during development
GUILD_ID=

# Server Default Timezone (IANA name, e.g., America/New_York, Europe/London, Asia/Tokyo, UTC)
DEFAULT_TIMEZONE=America/New_York

# SQLite Database File Path
DATABASE_PATH=data/polyglot.db

# Morning Challenge Report Time (24-hour clock, e.g. 08:00 = 8 AM)
MORNING_REPORT_HOUR=8
MORNING_REPORT_MINUTE=0

# Bot Display Name
BOT_NAME=Polyglot

